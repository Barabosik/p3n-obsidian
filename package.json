{
	"name": "p3n-obsidian",
	"version": "0.1.5",
	"description": "Select text, see if it reads as AI-written, or rewrite it in place, with the p3n API.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node --test tests/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Nikita Andreiev",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "1.14.4",
		"typescript": "5.8.3",
		"typescript-eslint": "^8.72.0"
	}
}
